<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ProjectsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surfaceDark"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/navMonthlyBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="Monthly"
            android:textColor="@color/accent"
            android:background="@drawable/nav_pill_inactive"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:onClick="monthlyAction"
            android:textSize="11sp"/>

        <Button
            android:id="@+id/navWeeklyBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="Weekly"
            android:textColor="@color/accent"
            android:background="@drawable/nav_pill_inactive"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:onClick="weeklyAction"
            android:textSize="11sp"/>

        <Button
            android:id="@+id/navDailyBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="Daily"
            android:textColor="@color/accent"
            android:background="@drawable/nav_pill_inactive"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:onClick="dailyAction"
            android:textSize="11sp"/>

        <Button
            android:id="@+id/navProjectsBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="Projects"
            android:textColor="@color/accent"
            android:background="@drawable/nav_pill_inactive"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:onClick="projectsAction"
            android:textSize="11sp"/>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Projects"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/textPrimary"
        android:textAlignment="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sort by:"
            android:textSize="14sp"
            android:textColor="@color/textSecondary"
            android:layout_marginEnd="8dp"/>

        <Spinner
            android:id="@+id/sortSpinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <TextView
        android:id="@+id/emptyProjectsTV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No projects yet. Create an event and select &quot;Project&quot; as the type."
        android:textSize="16sp"
        android:textColor="@color/textSecondary"
        android:textAlignment="center"
        android:padding="32dp"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/projectsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</LinearLayout>
